# 배포 서버의 주기 작업 (T03). 서버에서 한 번 설치한다:
#   sudo cp infra/cron/farmit /etc/cron.d/farmit
#
# 형식: 분 시 일 월 요일 사용자 명령. 시각은 UTC (server-setup.sh가 서버 시간대를 UTC로 맞춘다)
# 레포가 /home/ubuntu/farmit 에 있다고 본다 (README "처음 배포"의 clone 위치). 다르면 아래 경로를 고친다
# 결과 보기: journalctl -t farmit-flink -t farmit-airflow

# 1. Flink 작업 자동 제출 (5분마다)
#    Flink 컨테이너가 다시 뜨면(서버 재부팅, 배포) 제출해 둔 작업이 사라진다. 빠진 작업만 다시 제출한다
#    submit.sh는 이미 떠 있는 작업을 건너뛰므로 평소에는 아무 일도 하지 않는다 ("이미 실행 중" 줄은 기록하지 않는다)
*/5 * * * * ubuntu cd /home/ubuntu/farmit && for f in streaming/flink/*.sql; do bash streaming/flink/submit.sh "$(basename "$f" .sql)"; done 2>&1 | grep -v "이미 실행 중" | logger -t farmit-flink

# 2. airflow-scheduler 재시작 (매일 12:05 UTC = 한국 시간 21:05)
#    태스크가 scheduler 안에서 돌아서 돌수록 메모리가 늘어난다 (막 띄우면 약 400MiB → 오래 돌면 약 1.1GiB, docs/infra-memory.md)
#    재시작하면 돌던 태스크가 끊기므로 수집(22:00 UTC)·예측(일 23:00 UTC)과 먼 시각, 10분마다 도는 DAG를 피해 5분에 한다
5 12 * * * ubuntu cd /home/ubuntu/farmit && docker compose -f infra/docker-compose.yml --profile airflow restart airflow-scheduler 2>&1 | logger -t farmit-airflow
