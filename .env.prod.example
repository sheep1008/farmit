# 배포 서버용 (T02). 서버에서 복사해 .env를 만들고 빈 값을 채운다:  cp .env.prod.example .env
# 키 이름은 .env.example과 같다. 개발용과 값이 달라야 하는 곳에 [배포] 표시를 했다.
# .env는 커밋하지 않는다. 서버에서 만든 뒤 chmod 600 .env 로 다른 사용자가 못 읽게 한다.

# ── MySQL (mysql 컨테이너가 첫 실행 때 이 값으로 DB·계정을 만든다) ──
MYSQL_DATABASE=farmit
MYSQL_USER=farmit
# [배포] 개발용과 다른 긴 임의 문자열을 쓴다
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Django → MySQL 접속 ──
DB_HOST=mysql
DB_PORT=3306

# ── Django ──
# [배포] 개발용과 다른 값. 만들기: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# [배포] 반드시 False. True면 오류 화면에 설정값·코드가 그대로 보인다
DJANGO_DEBUG=False
# [배포] 서비스 도메인. 쉼표로 여러 개 (예: farmit.example.com,www.farmit.example.com)
# HTTPS 인증서도 이 도메인들로 받는다 (infra/scripts/issue-cert.sh). IP 주소는 적지 않는다
DJANGO_ALLOWED_HOSTS=
# [배포] 보통 비워 둔다. 화면과 API의 도메인이 다를 때만 https://도메인 형태로 적는다
DJANGO_CSRF_TRUSTED_ORIGINS=
# [배포] HTTPS 인증서를 붙인 뒤에는 True. 인증서를 붙이기 전(HTTP)에 로그인을 확인할 때만 잠깐 False
DJANGO_COOKIE_SECURE=True

# ── 외부 API 키 ──
DATA_GO_KR_KEY=
KOSIS_API_KEY=
NCPMS_API_KEY=
# 농사로 키는 신청서마다 따로 나온다 (.env.example 설명 참고)
# [배포] 신청할 때 적은 서비스 도메인이 localhost면 배포 도메인에서 호출되는지 확인한다
NONGSARO_API_KEY=
NONGSARO_WORKPLAN_KEY=
NONGSARO_WEEKFARM_KEY=
ANTHROPIC_API_KEY=
# LLM 모델 (비우면 claude-haiku-5-5)
LLM_MODEL=
# SSAFY GMS 키. 넣으면 ANTHROPIC_API_KEY 대신 GMS 프록시로 부른다
GMS_KEY=
# [배포] 회원별 하루 질문 수 (비우면 20). 공개 서비스라 호출 비용의 상한이 된다
LLM_DAILY_LIMIT=
KMA_APIHUB_KEY=
KAKAO_NAVI_KEY=
TRANSPORT_DEFAULT_COST_PER_KM=

# ── Airflow ──
# [배포] 개발용과 다른 값. 아래 접속 문자열의 <비밀번호>에도 같은 값을 넣는다
POSTGRES_PASSWORD=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:<비밀번호>@airflow-db/airflow
# [배포] 개발용과 다른 긴 임의 문자열
AIRFLOW__API_AUTH__JWT_SECRET=
# [배포] 새로 만든다 (만드는 명령은 .env.example 참고)
AIRFLOW__CORE__FERNET_KEY=

# ── Kafka (호스트에서 수집기를 실행할 때. 컨테이너 안에서는 kafka:9092) ──
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
