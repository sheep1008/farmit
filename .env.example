# 복사해서 .env를 만들고 빈 값을 채운다:  cp .env.example .env
# .env는 커밋하지 않는다.

# ── MySQL (mysql 컨테이너가 첫 실행 때 이 값으로 DB·계정을 만든다) ──
MYSQL_DATABASE=farmit
MYSQL_USER=farmit
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Django → MySQL 접속 (compose 안에서는 서비스 이름 mysql, 포트 3306) ──
DB_HOST=mysql
DB_PORT=3306

# ── Django ──
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── 외부 API 키 ──
DATA_GO_KR_KEY=
KOSIS_API_KEY=
NCPMS_API_KEY=
NONGSARO_API_KEY=
NONGSARO_WORKPLAN_KEY=
ANTHROPIC_API_KEY=
