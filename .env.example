# 복사해서 .env를 만들고 빈 값을 채운다:  cp .env.example .env
# .env는 커밋하지 않는다.

# ── MySQL (mysql 컨테이너가 첫 실행 때 이 값으로 DB·계정을 만든다) ──
MYSQL_DATABASE=farmit
MYSQL_USER=farmit
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Django → MySQL 접속 (compose 안에서는 서비스 이름 mysql, 포트 3306) ──
DB_HOST=mysql
DB_PORT=3306

# ── Django ──
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── 외부 API 키 ──
DATA_GO_KR_KEY=
KOSIS_API_KEY=
NCPMS_API_KEY=
# 농사로 키는 신청서마다 따로 나오고, 그 신청서에 넣은 서비스만 부를 수 있다 (다른 키로 부르면 결과코드 12)
# API_KEY: 현장기술지원·재해예방정보·길잡이·농업용어 / WORKPLAN_KEY: 농작업일정 / WEEKFARM_KEY: 주간농사정보·현장애로기술사례
NONGSARO_API_KEY=
NONGSARO_WORKPLAN_KEY=
NONGSARO_WEEKFARM_KEY=
ANTHROPIC_API_KEY=
# LLM 모델 (비우면 claude-haiku-5-5). claude-*는 Anthropic, gpt-*·o1·o3·o4는 OpenAI, gemini-*는 Gemini 형식으로 부른다.
# GPT·Gemini는 GMS_KEY가 있어야 한다. 이름은 GMS 모델 상세 페이지의 "model" 값 그대로 (예: claude-sonnet-5-5, gpt-4.1-mini, gemini-2.5-flash)
LLM_MODEL=
# SSAFY GMS 키. 넣으면 ANTHROPIC_API_KEY 대신 GMS 프록시(gms.ssafy.io)로 부른다. 비우면 Anthropic 직접 호출
GMS_KEY=
# 기상청 API허브(apihub.kma.go.kr) authKey. 관측소 목록(weather_station.json)을 다시 만들 때만 필요
KMA_APIHUB_KEY=
# 카카오모빌리티 자동차 길찾기 REST API 키 (developers.kakaomobility.com). 판매 추천의 도로 거리·통행료에 쓴다. 비우면 직선거리로 계산
KAKAO_NAVI_KEY=
# km당 운송비 기본 단가 (원/km, 비우면 170 = 포터 연료비 기준). 내 정보에 단가를 넣지 않은 회원에게 쓴다
TRANSPORT_DEFAULT_COST_PER_KM=

# ── Airflow (--profile airflow 로 켤 때만 필요) ──
# 메타DB(airflow-db, Postgres) 비밀번호. 아래 접속 문자열의 <비밀번호>에도 같은 값을 넣는다
POSTGRES_PASSWORD=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:<비밀번호>@airflow-db/airflow
# api-server와 scheduler가 태스크 토큰을 주고받을 때 쓰는 비밀값. 아무 긴 임의 문자열
AIRFLOW__API_AUTH__JWT_SECRET=
# Variable·Connection 암호화 키. 모든 Airflow 컨테이너가 같은 값을 써야 서로 읽을 수 있다. 만들기:
#   docker run --rm --entrypoint python farmit-airflow:3.3.2 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# ── Kafka (호스트에서 수집기를 실행할 때. 컨테이너 안에서는 kafka:9092) ──
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
